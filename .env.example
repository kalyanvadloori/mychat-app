# Copy this file to `.env` and paste the values from your Firebase project.
#
# Firebase console → Project settings (gear icon) → General tab →
# "Your apps" → Web app → SDK setup and configuration → Config.
# Project: mychat-e72b7
#
# Leave these blank and the app runs on the built-in mock backend instead.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mychat-e72b7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mychat-e72b7
VITE_FIREBASE_STORAGE_BUCKET=mychat-e72b7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Step 3 — Agora video calling (agora.io → Project → App ID)
VITE_AGORA_APP_ID=

# Step 4 — Push notifications (messages while the app is closed).
#
# Firebase console → Project settings → Cloud Messaging → Web configuration →
# "Web Push certificates" → Generate key pair. Paste the key here.
# Leave blank and notifications still work, but only while a tab is open.
VITE_FIREBASE_VAPID_KEY=

# Server-side only — set this in Netlify, NOT in this file's deployed copy.
# Firebase console → Project settings → Service accounts → Generate new private
# key. Paste the whole JSON (or its base64) into the Netlify environment
# variable FIREBASE_SERVICE_ACCOUNT. It can send as any user in the project, so
# it must never reach the browser or a VITE_ prefixed variable.
# FIREBASE_SERVICE_ACCOUNT=
