rules_version = '2';

// Paste these into: Firebase console → Firestore Database → Rules → Publish.
// They replace the 30-day test-mode rules, which expire and then lock the app out.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participantIds;
    }

    // Profiles are readable by any signed-in user (needed for the contact list),
    // but each person can only write their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      // Push registrations, one document per browser, keyed by the FCM token.
      //
      // Not readable by anyone: only the `send-push` function needs them, and it
      // uses the service account, which bypasses these rules entirely. Leaving
      // them readable would let any signed-in user harvest everyone's tokens.
      match /pushTokens/{token} {
        allow read: if false;
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(resource.data);

      // A new thread must include its creator and exactly two people.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;

      // Participants may update the thread but never change who is in it.
      allow update: if isParticipant(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds;

      // "Delete chat" removes the thread for both people.
      allow delete: if isParticipant(resource.data);

      match /messages/{messageId} {
        function parent() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isParticipant(parent());

        // You may only post as yourself, and only into your own threads.
        allow create: if isParticipant(parent())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;

        // Only the author may edit, only the wording, and never the attribution:
        // rewriting someone else's message or reassigning who sent it stays barred.
        allow update: if isParticipant(parent())
          && request.auth.uid == resource.data.senderId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;

        // Vanish mode and "unsend" both delete; either participant may.
        allow delete: if isParticipant(parent());
      }
    }
  }
}
